<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Clock" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF9CC3F5</item>
        <item name="android:colorBackground">#FF121E33</item>
        <item name="android:windowBackground">@drawable/clock_window</item>
        <item name="android:textColorPrimary">#FFF4EFE6</item>
        <item name="android:textColorSecondary">#FFB9C4D6</item>
        <item name="android:timePickerStyle">@style/ClockFace</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/ClockWord</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/ClockWord</item>
    </style>
    <style name="ClockFace" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">#FF0A1322</item>
        <item name="android:numbersBackgroundColor">#FF0A1322</item>
        <item name="android:numbersSelectorColor">#FF9CC3F5</item>
        <item name="android:numbersTextColor">#FFF4EFE6</item>
    </style>
    <style name="ClockWord" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FF9CC3F5</item>
    </style>
</resources>
