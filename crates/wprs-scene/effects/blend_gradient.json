{
  "id": "blend_gradient",
  "name": { "en": "Gradient blend" },
  "category": "blend",
  "description": { "en": "Blends in a texture using a gradient map to control where it shows.", "es": "Mezcla una textura usando un mapa de degradado que controla dónde se ve." },
  "mask_mode": "strength",
  "params": [
    { "id": "texture", "type": "texture", "default": "" },
    { "id": "map", "type": "texture", "tools": ["gray"], "default": "" },
    { "id": "progress", "type": "float", "default": 0.5, "min": 0, "max": 1 },
    { "id": "softness", "type": "float", "default": 0.1, "min": 0, "max": 1 }
  ],
  "passes": [{ "entry": "fs_blend_gradient", "inputs": ["previous", "asset:texture", "asset:map"] }]
}
