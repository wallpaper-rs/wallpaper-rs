{
  "id": "spin",
  "name": { "en": "Spin" },
  "category": "motion",
  "description": { "en": "Spins the picture around a center point.", "es": "Hace girar la imagen alrededor de un punto central." },
  "mask_mode": "strength",
  "params": [
    { "id": "center", "type": "position", "default": [0.5, 0.5] },
    { "id": "angle", "type": "float", "unit": "degrees", "default": 0, "min": -360, "max": 360 },
    { "id": "speed", "type": "float", "default": 0, "min": -720, "max": 720, "uses": "time" },
    { "id": "radius", "type": "float", "default": 0.5, "min": 0, "max": 2 }
  ],
  "fuse": "uv"
}
