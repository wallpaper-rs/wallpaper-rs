{
  "id": "sway",
  "name": { "en": "Sway" },
  "category": "motion",
  "description": "Sways the picture like something hanging, with stiffness and spread, or makes foliage tremble.",
  "min_fps": 30,
  "mask_mode": "strength",
  "params": [
    { "id": "amplitude", "type": "float", "default": 6, "min": 0, "max": 256, "uses": "time" },
    { "id": "speed", "type": "float", "default": 0.4, "min": 0, "max": 10 },
    { "id": "stiffness", "type": "float", "default": 2, "min": 0, "max": 8 },
    { "id": "spread", "type": "float", "default": 1.5, "min": 0, "max": 64 },
    { "id": "swing", "type": "bool", "default": false },
    { "id": "angle", "type": "float", "default": 3, "min": 0, "max": 90 },
    { "id": "pivot", "type": "vec2", "default": [0.5, 0], "min": -1, "max": 2 },
    { "id": "double", "type": "bool", "default": false },
    { "id": "phase", "type": "texture", "tools": ["gray"], "default": "" },
    { "id": "foliage", "type": "bool", "default": false },
    { "id": "ratio", "type": "float", "default": 1, "min": 0.1, "max": 10 }
  ],
  "passes": [{ "entry": "fs_sway", "inputs": ["previous", "asset:phase"] }],
  "fuse": "uv",
  "reach": "amplitude"
}
