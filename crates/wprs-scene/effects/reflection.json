{
  "id": "reflection",
  "name": { "en": "Reflection" },
  "category": "light",
  "description": "Adds a wavy reflection below the picture.",
  "min_fps": 30,
  "mask_mode": "strength",
  "params": [
    { "id": "line", "type": "float", "default": 0.6, "min": 0, "max": 1 },
    { "id": "opacity", "type": "float", "default": 0.6, "min": 0, "max": 1 },
    { "id": "fade", "type": "float", "default": 1, "min": 0, "max": 1 },
    { "id": "amplitude", "type": "float", "default": 2, "min": 0, "max": 128, "uses": "time" },
    { "id": "frequency", "type": "float", "default": 12, "min": 0, "max": 512 },
    { "id": "speed", "type": "float", "default": 0.5, "min": -20, "max": 20 },
    { "id": "angle", "type": "float", "unit": "degrees", "default": 0, "min": -360, "max": 360 }
  ],
  "passes": [{ "entry": "fs_reflection" }],
  "reach": "amplitude"
}
