{
  "id": "depth_parallax",
  "name": { "en": "Depth parallax" },
  "category": "distort",
  "description": "Shifts layers by a depth map as the pointer moves, for a 3D-ish parallax.",
  "mask_mode": "strength",
  "params": [
    { "id": "depth", "type": "texture", "tools": ["gray", "depth"], "default": "" },
    { "id": "strength", "type": "float", "default": 24, "min": 0, "max": 256 },
    { "id": "focus", "type": "float", "default": 0.5, "min": 0, "max": 1 },
    { "id": "steps", "type": "float", "default": 16, "min": 8, "max": 24 },
    { "id": "overscan", "type": "float", "default": 1, "min": 1, "max": 1.25 },
    { "id": "follow", "type": "bool", "default": true, "uses": "cursor" },
    { "id": "orbit", "type": "bool", "default": false, "uses": "time" },
    { "id": "scale", "type": "vec2", "default": [1, 1], "min": -1, "max": 1 },
    { "id": "smooth", "type": "bool", "default": false }
  ],
  "passes": [{ "entry": "fs_depth_parallax", "inputs": ["previous", "asset:depth"] }],
  "cost": { "taps": 3 },
  "reach": "strength",
  "quality": { "q2": { "params": { "steps": 12 } }, "q1": { "params": { "steps": 8 } } }
}
