{
  "schema": "wallpaper-rs.scene/1",
  "canvas": { "size": [1920, 1080], "fit": "fill", "background": "#000000" },
  "clock": { "max_fps": "display" },
  "scripts": [{ "path": "scripts/pulso.js", "events": ["update"], "uses": ["audio"] }],
  "layers": [
    { "id": "fondo", "type": "shape", "shape": { "rect": { "size": [1920, 1080] } }, "gradient": { "stops": [[0, "#101828"], [1, "#283a5c"]] } },
    { "id": "destello", "type": "shape", "shape": { "rect": { "size": [1920, 1080] } }, "fill": "#ffffff", "opacity": 0 },
    { "id": "pulso", "type": "shape", "shape": { "ring": { "size": [500, 500], "width": 24 } }, "fill": "#ff4fd8" }
  ]
}
