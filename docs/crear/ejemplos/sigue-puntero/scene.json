{
  "schema": "wallpaper-rs.scene/1",
  "canvas": { "size": [1920, 1080], "fit": "fill", "background": "#000000" },
  "clock": { "max_fps": "display" },
  "scripts": [{ "path": "scripts/sigue.js", "events": ["update"], "uses": ["pointer"] }],
  "layers": [
    { "id": "fondo", "type": "shape", "shape": { "rect": { "size": [1920, 1080] } }, "gradient": { "stops": [[0, "#101828"], [1, "#283a5c"]] } },
    { "id": "cola", "type": "shape", "shape": { "ellipse": { "size": [60, 60] } }, "fill": "#5ee7ff", "opacity": 0.3 },
    { "id": "medio", "type": "shape", "shape": { "ellipse": { "size": [90, 90] } }, "fill": "#5ee7ff", "opacity": 0.6 },
    { "id": "cabeza", "type": "shape", "shape": { "ellipse": { "size": [120, 120] } }, "fill": "#5ee7ff" }
  ]
}
