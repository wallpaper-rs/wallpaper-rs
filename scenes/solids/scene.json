{
  "schema": "wallpaper-rs.scene/1",
  "canvas": { "size": [1920, 1080], "background": "#10162b", "ambient": "#232a4a", "sky": "#34447a" },
  "clock": { "max_fps": "display", "poster_time": 2 },
  "camera3d": { "fov": 40, "eye": [4, 3, 8], "center": [0, 0.4, 0] },
  "timelines": [{ "id": "turn", "duration": 12, "loop": "repeat" }],
  "assets": { "crate": { "path": "assets/crate.glb" } },
  "layers": [
    { "id": "backdrop", "type": "solid", "color": "#10162b" },
    { "id": "stage", "type": "group", "space": "3d", "layers": [
      { "id": "floor", "type": "model", "model": "crate", "position": [0, -1.2, 0], "scale": [5, 0.1, 5],
        "materials": { "paint": { "color": "#3a4468", "params": { "roughness": 0.8 } } } },
      { "id": "box", "type": "model", "model": "crate", "position": [0, 0, 0],
        "rotation": { "timeline": "turn", "keys": [[0, [0, 0, 0]], [12, [0, 360, 0]]] } }
    ] },
    { "id": "sun", "type": "light", "light": "directional", "color": "#fff1d6", "intensity": 1.4,
      "shadows": true, "shadow_resolution": 1024, "shadow_bias": 0.2,
      "position3d": [4, 6, 3], "aim3d": [0, 0, 0] }
  ]
}
